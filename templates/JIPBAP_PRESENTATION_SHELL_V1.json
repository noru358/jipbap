{
  "schema": "JIPBAP_PRESENTATION_SHELL_V1",
  "canvas": {
    "width": 1080,
    "height": 1350,
    "ratio": "4:5"
  },
  "body": {
    "artwork_frame": {
      "x": 40,
      "y": 175,
      "width": 1000,
      "height": 1000,
      "fit": "contain_1to1",
      "allow_stretch": false
    },
    "page_markers": false,
    "text_policy": "move_or_compress_text_never_move_artwork"
  },
  "cover": {
    "title_safe_region": {
      "x": 60,
      "y": 50,
      "width": 960,
      "height": 250
    },
    "hero_frame": {
      "x": 60,
      "y": 330,
      "width": 960,
      "height": 960,
      "fit": "contain_1to1",
      "allow_stretch": false
    },
    "default_objects": [
      "menu_tag",
      "title",
      "hero_artwork"
    ],
    "subtitle_default": false
  },
  "lettering": {
    "speech": {
      "container": "bubble",
      "fill": "#FFFFFF",
      "stroke": "#2A2A2A",
      "stroke_width": 4,
      "tail": true
    },
    "inner_thought": {
      "container": "thought_box",
      "fill": "#FFF7E8",
      "stroke": "#B7A995",
      "stroke_width": 2,
      "tail": false
    },
    "sfx": {
      "container": "none",
      "editable": true,
      "rotation_allowed": true
    }
  }
}