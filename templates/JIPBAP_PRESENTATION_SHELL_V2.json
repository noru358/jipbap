      "resize": true,
      "rotation": true
    },
    "image_replacement_capability": true
  },
  "z_bands": {
    "background": [
      0,
      0
    ],
    "artwork": [
      1,
      9
    ],
    "lettering": [
      10,
      99
    ],
    "overlay": [
      100,
      199
    ]
  },
  "lettering": {
    "speech": {
      "container": "bubble",
      "fill": "#FFFFFF",
      "stroke": "#2A2A2A",
      "stroke_width": 4,
      "tail": true
