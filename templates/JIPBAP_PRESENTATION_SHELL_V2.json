      "x": 40,
      "y": 40,
      "width": 1000,
      "height": 1000,
      "fit": "frame_crop",
      "default_locked": true,
      "allow_stretch": false
    },
    "meta_region": {
      "x": 60,
      "y": 1080,
      "width": 960,
      "height": 230,
      "visible_container_required": false
    },
    "semantic_placement": {
      "speech": "artwork",
      "sfx": "artwork",
      "inner_thought": "meta_region",
      "narration": "meta_region"
    },
    "page_markers": false,
    "group_contract": {
      "top_level_pattern": [
        "{page}.background",
        "{page}.artwork",
        "{page}.lettering",
        "{page}.overlay"
      ],
      "lettering_instance_patterns": [
        "{page}.speech.NN",
        "{page}.thought.NN",
        "{page}.narration.NN",
        "{page}.sfx.NN"
      ],
      "fixed_instance_count": false
    }
  },
  "cover": {
    "title_region": {
      "x": 60,
      "y": 40,
      "width": 960,
      "height": 240
    },
    "hero_frame": {
      "x": 40,
      "y": 310,
      "width": 1000,
      "height": 1000,
      "fit": "frame_crop",
      "default_locked": true,
      "allow_stretch": false
    },
    "default_objects": [
      "menu_tag",
      "title",
      "hero_artwork"
    ],
    "subtitle_default": false,
