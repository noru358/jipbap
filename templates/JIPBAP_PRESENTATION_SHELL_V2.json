      "top_level": [
        "cover.background",
        "cover.artwork",
        "cover.lettering",
        "cover.overlay"
      ],
      "lettering_children": [
        "cover.menu_tag",
        "cover.title"
      ],
      "subtitle_group": "optional_hidden_by_default"
    }
  },
  "editor_defaults": {
    "background": {
      "locked": true,
      "visible": true
