{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jipbap Project Calibration State",
  "type": "object",
  "required": [
    "version",
    "person_style",
    "food_style",
    "cover_template",
    "lettering_template",
    "next_action"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "person_style": {
      "$ref": "#/$defs/item"
    },
    "food_style": {
      "$ref": "#/$defs/item"
    },
    "cover_template": {
      "$ref": "#/$defs/item"
    },
    "lettering_template": {
      "$ref": "#/$defs/item"
    },
    "next_action": {
      "type": "string",
      "enum": [
        "PERSON_STYLE",
        "FOOD_STYLE",
        "COVER_TEMPLATE",
        "LETTERING_TEMPLATE",
        "READY_FOR_EPISODE"
      ]
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "IN_TEST",
            "USER_LOCKED",
            "FAILED"
          ]
        },
        "authority_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_artifact_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
