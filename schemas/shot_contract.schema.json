{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jipbap Shot Contract",
  "type": "object",
  "required": [
    "shot_id",
    "beat_role",
    "meal_context",
    "preconditions",
    "action",
    "postconditions",
    "must_show",
    "must_not_show",
    "output"
  ],
  "properties": {
    "shot_id": {"type": "string"},
    "beat_role": {"type": "string"},
    "meal_context": {
      "type": "object",
      "required": ["context_id", "constraints"],
      "properties": {
        "context_id": {"type": "string", "minLength": 1},
        "constraints": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "action": {"type": "string", "minLength": 1},
    "postconditions": {"type": "array", "items": {"type": "string"}},
    "must_show": {"type": "array", "items": {"type": "string"}},
    "must_not_show": {"type": "array", "items": {"type": "string"}},
    "composition": {"type": "string"},
    "reference_roles": {"type": "array", "items": {"type": "string"}},
    "output": {
      "type": "object",
      "required": ["single_panel", "text_free", "delivery_mode"],
      "properties": {
        "single_panel": {"const": true},
        "text_free": {"const": true},
        "delivery_mode": {"const": "SEPARATE_FILE"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
