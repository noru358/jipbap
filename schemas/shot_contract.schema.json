{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jipbap Shot Contract",
  "type": "object",
  "required": [
    "shot_id",
    "beat_role",
    "meal_context",
    "reference_bindings",
    "subject_bindings",
    "context_firewall",
    "coverage",
    "geometry",
    "preconditions",
    "action",
    "postconditions",
    "must_show",
    "must_not_show",
    "output",
    "appetite",
    "background",
    "entity_visibility"
  ],
  "properties": {
    "shot_id": {
      "type": "string"
    },
    "beat_role": {
      "type": "string"
    },
    "meal_context": {
      "type": "object",
      "required": [
        "context_id",
        "constraints",
        "dining_grammar"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "dining_grammar": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "reference_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref_id",
          "role",
          "is_edit_target",
          "coverage_scope"
        ],
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "PERSON_STYLE_AUTHORITY",
              "FOOD_STYLE_AUTHORITY",
              "BACKGROUND_STYLE_AUTHORITY",
              "GRAPHIC_STYLE_AUTHORITY",
              "CONTINUITY_ANCHOR",
              "EDIT_TARGET"
            ]
          },
          "is_edit_target": {
            "type": "boolean"
          },
          "allowed_influence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverage_scope": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "subject_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject_id",
          "recurring",
          "visible"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "recurring": {
            "type": "boolean"
          },
          "visible": {
            "type": "boolean"
          },
          "subject_lock_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "identity_anchor_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "identity_invariants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "context_firewall": {
      "type": "object",
      "required": [
        "target_only",
        "deny_future_shots",
        "deny_voice_copy",
        "deny_rejected_outputs"
      ],
      "properties": {
        "target_only": {
          "const": true
        },
        "deny_future_shots": {
          "const": true
        },
        "deny_voice_copy": {
          "const": true
        },
        "deny_rejected_outputs": {
          "const": true
        },
        "deny_locked_shot_as_edit_target": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "focal_owner",
        "shot_scale",
        "camera_relation",
        "visual_delta_from_previous"
      ],
      "properties": {
        "focal_owner": {
          "type": "string",
          "minLength": 1
        },
        "shot_scale": {
          "type": "string",
          "minLength": 1
        },
        "camera_relation": {
          "type": "string",
          "minLength": 1
        },
        "visual_delta_from_previous": {
          "type": "string"
        },
        "repetition_justification": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "geometry": {
      "type": "object",
      "required": [
        "risk_level",
        "contact_chain",
        "anatomy_checks"
      ],
      "properties": {
        "risk_level": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "contact_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anatomy_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "must_show": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "must_not_show": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "composition": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "required": [
        "target_shot_id",
        "single_panel",
        "text_free",
        "delivery_mode"
      ],
      "properties": {
        "target_shot_id": {
          "type": "string"
        },
        "single_panel": {
          "const": true
        },
        "text_free": {
          "const": true
        },
        "delivery_mode": {
          "const": "SEPARATE_FILE"
        }
      },
      "additionalProperties": true
    },
    "scene_state_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "state_delta": {
      "type": "object",
      "additionalProperties": true
    },
    "appetite": {
      "type": "object",
      "required": [
        "functions",
        "sensory_payload",
        "reader_proxy_value",
        "observable_cues",
        "temporal_distinguishability"
      ],
      "properties": {
        "functions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ANTICIPATION",
              "SENSORY_REVEAL",
              "TRANSFORMATION",
              "INGESTION",
              "AFTERTASTE",
              "SECONDARY_PAYOFF"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sensory_payload": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "reader_proxy_value": {
          "type": "string",
          "minLength": 1
        },
        "observable_cues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "temporal_distinguishability": {
          "type": "string",
          "minLength": 1
        },
        "forbidden_ad_cues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "background": {
      "type": "object",
      "required": [
        "scope",
        "visible_facts"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "NONE",
            "LOCAL",
            "FULL"
          ]
        },
        "visible_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "location_lock_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "entity_visibility": {
      "type": "object",
      "required": [
        "required",
        "allowed",
        "forbidden"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
