{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jipbap Episode Render State",
  "type": "object",
  "required": [
    "episode_id",
    "stage",
    "render_cursor",
    "approved_locked_shots",
    "retry_scope",
    "next_user_gate",
    "sequence_qc_status",
    "cover_status",
    "cover_source_route",
    "lettering_status",
    "anchor_route",
    "anchor_gate_status",
    "anchor_artifact_id"
  ],
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "PREPRODUCTION_USER_GATE",
        "S01_PENDING",
        "POST_S01_INTERNAL_RENDER",
        "RASTER_SET_USER_GATE",
        "POST_RASTER_COMPOSITION",
        "FINAL_USER_GATE",
        "COMPLETE",
        "ANCHOR_PENDING",
        "POST_ANCHOR_INTERNAL_RENDER"
      ]
    },
    "render_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_locked_shots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "retry_scope": {
      "const": "CURRENT_SHOT_ONLY"
    },
    "next_user_gate": {
      "type": "string",
      "enum": [
        "S01",
        "RASTER_SET",
        "FINAL",
        "NONE",
        "ANCHOR"
      ]
    },
    "anchor_policy": {
      "type": "string",
      "const": "CONTINUITY_ONLY_UNLESS_EXPLICIT_EDIT"
    },
    "sequence_qc_status": {
      "type": "string",
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL"
      ]
    },
    "cover_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "PENDING",
        "PASS",
        "FAIL"
      ]
    },
    "cover_source_route": {
      "type": "string",
      "enum": [
        "UNRESOLVED",
        "BODY_REUSE",
        "DEDICATED",
        "EXTERNAL_IMPORT"
      ]
    },
    "lettering_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "PASS",
        "FAIL"
      ]
    },
    "anchor_route": {
      "type": "string",
      "enum": [
        "UNRESOLVED",
        "BODY_S01",
        "DEDICATED_A00"
      ]
    },
    "anchor_gate_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "PENDING",
        "PASS",
        "FAIL"
      ]
    },
    "anchor_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "FINAL_USER_GATE",
              "COMPLETE"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "sequence_qc_status": {
            "const": "PASS"
          },
          "cover_status": {
            "const": "PASS"
          },
          "lettering_status": {
            "const": "PASS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "anchor_route": {
            "const": "BODY_S01"
          },
          "anchor_gate_status": {
            "const": "PASS"
          }
        },
        "required": [
          "anchor_route",
          "anchor_gate_status"
        ]
      },
      "then": {
        "properties": {
          "anchor_artifact_id": {
            "const": "S01"
          },
          "approved_locked_shots": {
            "contains": {
              "const": "S01"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "anchor_route": {
            "const": "DEDICATED_A00"
          },
          "anchor_gate_status": {
            "const": "PASS"
          }
        },
        "required": [
          "anchor_route",
          "anchor_gate_status"
        ]
      },
      "then": {
        "properties": {
          "anchor_artifact_id": {
            "const": "A00"
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
