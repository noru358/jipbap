{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noru358/jipbap/schemas/editor_scene_model_v1.schema.json",
  "title": "EDITOR_SCENE_MODEL_V1",
  "type": "object",
  "required": [
    "schema",
    "scene_model",
    "template_id",
    "page",
    "groups",
    "objects"
  ],
  "properties": {
    "schema": {
      "const": "EDITABLE_COMPOSITION_PACKAGE_V1"
    },
    "scene_model": {
      "const": "EDITOR_SCENE_MODEL_V1"
    },
    "template_id": {
      "type": "string"
    },
    "page": {
      "type": "object",
      "required": [
        "width",
        "height",
        "background",
        "page_type"
      ],
      "properties": {
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1350
        },
        "background": {
          "type": "string"
        },
        "page_type": {
          "enum": [
            "cover",
            "body"
          ]
        },
        "placement_guides": {
          "type": "array",
          "description": "Optional soft placement hints for lettering; never a BOARD hard gate.",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "avoid_regions": {
          "type": "array",
          "description": "Optional focal regions such as face_primary, food_primary, hand_action.",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "width",
              "height",
              "role"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "role": {
                "type": "string"
              },
              "priority": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        },
        "cover_artwork_provenance": {
          "type": "object",
          "description": "Sticky provenance for approved COVER artwork. New V1 production pixel-locks the approved COVER source at ART_BUNDLE_USER_GATE and reuses that exact source; PAGE_FINAL_RECOMPOSE remains schema-readable only for historical packages.",
          "properties": {
            "source": {
              "type": "string"
            },
            "source_kind": {
              "type": "string"
            },
            "source_page_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "crop": {
              "type": "object"
            },
            "locked_for_final_candidate": {
              "type": "boolean"
            },
            "finalization_method": {
              "type": "string",
              "enum": [
                "PAGE_FINAL_RECOMPOSE",
                "EXACT_ANCHOR_REUSE",
                "LEGACY_ACCEPTED_RASTER"
              ],
              "description": "New production uses EXACT_ANCHOR_REUSE. PAGE_FINAL_RECOMPOSE is retained only for backward compatibility with historical episode packages."
            },
            "anchor_source_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "contract_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "approved_source_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_identity_locked": {
              "type": "boolean"
            },
            "stochastic_regeneration_allowed": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "presentation_target": {
          "type": "object",
          "description": "Page-local presentation-master provenance/target metadata. It is a visual design reference and must not replace accepted artwork bytes.",
          "properties": {
            "source": {
              "type": "string"
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "type": "string"
            },
            "parity_required": {
              "type": "boolean"
            },
            "non_exporting_reference": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "artwork_provenance": {
          "type": "object",
          "description": "Sticky page artwork provenance. New V1 BODY pages are exact deterministic crops of the approved BODY board (EXACT_EXTRACTION_REUSE); COVER uses exact approved source reuse. PAGE_FINAL_RECOMPOSE remains schema-readable only for historical packages.",
          "properties": {
            "source": {
              "type": "string"
            },
            "source_kind": {
              "type": "string"
            },
            "source_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "extraction_metadata_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "extraction_box_index": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "locked_for_final_candidate": {
              "type": "boolean"
            },
            "finalization_method": {
              "type": "string",
              "enum": [
                "PAGE_FINAL_RECOMPOSE",
                "EXACT_EXTRACTION_REUSE",
                "EXACT_ANCHOR_REUSE",
                "LEGACY_ACCEPTED_RASTER"
              ],
              "description": "New production uses EXACT_EXTRACTION_REUSE for BODY and EXACT_ANCHOR_REUSE for COVER. PAGE_FINAL_RECOMPOSE is legacy-readable only."
            },
            "anchor_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "anchor_sha256s": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contract_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "contract_qc_passed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "approved_source_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_identity_locked": {
              "type": "boolean"
            },
            "stochastic_regeneration_allowed": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "z_band",
          "visible",
          "locked"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "z_band": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "visible": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          },
          "interaction": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "group_id",
          "visible",
          "locked",
          "z"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "artwork",
              "bubble",
              "thought_box",
              "caption_box",
              "text",
              "sfx",
              "shape"
            ]
          },
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "visible": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          },
          "rotation": {
            "type": "number"
          },
          "z": {
            "type": "integer"
          },
          "crop": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "frame_crop"
              },
              "scale": {
                "type": "number",
                "minimum": 1
              },
              "offset_x": {
                "type": "number"
              },
              "offset_y": {
                "type": "number"
              },
              "anchor_x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "anchor_y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "allow_stretch": {
                "const": false
              },
              "allow_rotation": {
                "const": false
              },
              "clamp_to_frame": {
                "const": true
              },
              "editable": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          },
          "font": {
            "type": "object",
            "properties": {
              "family_intent": {
                "type": "string"
              },
              "preferred_family": {
                "type": "string"
              },
              "fallback_families": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resolved_family": {
                "type": "string"
              },
              "size": {
                "type": "number"
              },
              "weight": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "resolved_weight": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "substituted": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          },
          "tail": {
            "type": "object",
            "description": "Editable speech-bubble tail geometry. Legacy tail_to may still be read.",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "style": {
                "enum": [
                  "soft_curved",
                  "triangle"
                ]
              },
              "tip_x": {
                "type": "number"
              },
              "tip_y": {
                "type": "number"
              },
              "attach_side": {
                "enum": [
                  "top",
                  "right",
                  "bottom",
                  "left"
                ]
              },
              "attach": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "base_width": {
                "type": "number",
                "minimum": 8
              },
              "curve": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": true
          },
          "manual_overrides": {
            "type": "array",
            "description": "Property-level user edit markers. These are merge-preservation hints, not object locks.",
            "items": {
              "enum": [
                "position",
                "size",
                "rotation",
                "z_order",
                "visibility",
                "line_breaks",
                "text",
                "typography",
                "tail_tip",
                "tail_attachment",
                "tail_shape",
                "bubble_style",
                "crop",
                "artwork_source",
                "object_presence"
              ]
            },
            "uniqueItems": true
          },
          "layout_attention": {
            "type": "array",
            "description": "Non-destructive issues requiring reflow or manual review; never an excuse to silently discard manual edits.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "padding": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "number",
                    "minimum": 0
                  },
                  "right": {
                    "type": "number",
                    "minimum": 0
                  },
                  "top": {
                    "type": "number",
                    "minimum": 0
                  },
                  "bottom": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "presentation_target": {
      "type": "object",
      "description": "Optional page-level binding to the approved PRESENTATION_MASTER visual target used for editable reconstruction parity.",
      "properties": {
        "source": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "const": "PRESENTATION_MASTER_VISUAL_TARGET"
        },
        "literal_text_authority": {
          "type": "string"
        },
        "parity_required": {
          "type": "boolean"
        },
        "non_exporting_reference": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
